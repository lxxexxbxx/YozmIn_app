# Google API Keys
EXPO_PUBLIC_API_KEY=your_google_api_key_here
EXPO_PUBLIC_SEARCH_ENGINE_ID=your_search_engine_id_here

# Naver API Keys
EXPO_PUBLIC_NAVER_CLIENT_ID=your_naver_client_id_here
EXPO_PUBLIC_NAVER_CLIENT=your_naver_client_secret_here

# Supabase
EXPO_PUBLIC_SUPABASE_URL=your_supabase_url_here
EXPO_PUBLIC_SUPABASE_API_KEY=your_supabase_anon_key_here

# TMDB (The Movie Database)
EXPO_PUBLIC_TMDB_API_KEY=your_tmdb_api_key_here

# IGDB (Internet Game Database)
EXPO_PUBLIC_IGDB_CLIENT_ID=your_igdb_client_id_here
EXPO_PUBLIC_IGDB_ACCESS_TOKEN=your_igdb_access_token_here

# Kakao
EXPO_PUBLIC_KAKAO_JS_KEY=your_kakao_js_key_here
EXPO_PUBLIC_KAKAO_NATIVE_APP_KEY=your_kakao_native_app_key_here
EXPO_PUBLIC_KAKAO_REST_API_KEY=your_kakao_rest_api_key_here
EXPO_PUBLIC_KAKAO_ADMIN_KEY=your_kakao_admin_key_here

# Hugging Face
EXPO_PUBLIC_HF_TOKEN=your_hugging_face_token_here

# Gemini API
EXPO_PUBLIC_GEMINI_API_KEY=your_gemini_api_key_here
